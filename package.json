{
  "name": "origins-builder",
  "version": "1.1.0",
  "description": "Origins Builder \u2014 a visual block editor for Minecraft Origins mod",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.originsbuilder.app",
    "productName": "Origins Builder",
    "icon": "icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "origins-editor.html",
      "origins-manager.html",
      "origins-settings.html",
      "icon.png",
      "origins-guide.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Origins Builder"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "DensityV",
      "repo": "origins-builder"
    }
  },
  "author": "Origins Builder",
  "dependencies": {
    "electron-updater": "^6.1.0"
  }
}